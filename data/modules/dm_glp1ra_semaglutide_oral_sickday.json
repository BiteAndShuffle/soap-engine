  "addons": {
    "items": {
      "counseling:counseling_1": {
        "key": "counseling:counseling_1",
        "id": "counseling_1",
        "group": "counseling",
        "targetSection": "P",
        "text": "高血糖が持続すると、網膜症・腎症・神経障害などの合併症を生じる可能性があります。食事療法および運動療法の重要性について指導。間食はカロリーオフ・ノンシュガー食品への置き換えを提案。血糖改善に伴い低血糖症状が出現する可能性について注意喚起。"
      },
      "counseling:counseling_forget_alarm": {
        "key": "counseling:counseling_forget_alarm",
        "id": "counseling_forget_alarm",
        "group": "counseling",
        "targetSection": "P",
        "text": "忘れ防止策としてアラーム設定を提案。"
      },
      "counseling:counseling_forget_prepare": {
        "key": "counseling:counseling_forget_prepare",
        "id": "counseling_forget_prepare",
        "group": "counseling",
        "targetSection": "P",
        "text": "忘れ防止策として、食事前に薬剤を準備する習慣づけを提案。"
      },
      "sickday:sickday_common_addon_1": {
        "key": "sickday:sickday_common_addon_1",
        "id": "sickday_common_addon_1",
        "group": "sickday",
        "targetSection": "P",
        "text": "併用中のSGLT2阻害薬やメトホルミンは脱水時は中止が必要な場合があります。自己判断で中止せず、処方医へご相談ください。"
      },
      "oral:oral_storage": {
        "key": "oral:oral_storage",
        "id": "oral_storage",
        "group": "oral",
        "targetSection": "P",
        "text": "湿気に弱いため、PTPシートはミシン目以外で切り離さないでください。"
      },
      "oral:oral_admin": {
        "key": "oral:oral_admin",
        "id": "oral_admin",
        "group": "oral",
        "targetSection": "P",
        "text": "起床後すぐ、最初の1錠としてコップ半分（120mL以下）の水で服用してください。服用後30分は、飲食や他の薬の服用は避けてください。"
      },
      "sideEffects:se_digestive": {
        "key": "sideEffects:se_digestive",
        "id": "se_digestive",
        "group": "sideEffects",
        "targetSection": "P",
        "text": "吐き気などの消化器症状が出ることがあります。症状が続く場合はご相談ください。"
      },
      "sideEffects:se_hypoglycemia": {
        "key": "sideEffects:se_hypoglycemia",
        "id": "se_hypoglycemia",
        "group": "sideEffects",
        "targetSection": "P",
        "text": "他の糖尿病薬と併用している場合は、ふらつき・動悸などの低血糖症状が出ることがあります。"
      }
    },
