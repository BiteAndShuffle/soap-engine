  "addons": {
    "items": {
      "addon_glycemic_guidance": {
        "key": "addon_glycemic_guidance",
        "id": "addon_glycemic_guidance",
        "title": "血糖指導",
        "group": "counseling",
        "targetSection": "P",
        "text": "高血糖が持続すると、網膜症・腎症・神経障害などの合併症を生じる可能性があります。食事療法および運動療法の重要性について指導。間食はカロリーオフ・ノンシュガー食品への置き換えを提案。血糖改善に伴い低血糖症状が出現する可能性について注意喚起。"
      },
      "addon_oral_ribelsus_admin": {
        "key": "addon_oral_ribelsus_admin",
        "id": "addon_oral_ribelsus_admin",
        "title": "リベルサス（セマグルチド）説明",
        "group": "oral",
        "targetSection": "P",
        "text": "湿気に弱いため、PTPシートはミシン目以外で切り離さないでください。起床後すぐ、最初の1錠としてコップ半分（120mL以下）の水で服用してください。服用後30分は、飲食や他の薬の服用は避けてください。30分以上空けてから朝食をとってください。"
      },
      "addon_se_hypoglycemia_guidance": {
        "key": "addon_se_hypoglycemia_guidance",
        "id": "addon_se_hypoglycemia_guidance",
        "title": "副作用注意喚起（低血糖）",
        "group": "sideEffects",
        "targetSection": "P",
        "text": "他の糖尿病薬と併用している場合は、ふらつき・動悸などの低血糖症状が出ることがあります。低血糖症状が出た場合は、速やかにブドウ糖や糖分を摂取するよう指導。"
      },
      "addon_adherence_alarm_suggestion": {
        "key": "addon_adherence_alarm_suggestion",
        "id": "addon_adherence_alarm_suggestion",
        "title": "服薬忘れ対策（アラーム）",
        "group": "adherence",
        "targetSection": "P",
        "text": "忘れ防止策としてアラーム設定を提案。"
      },
      "addon_adherence_prep_before_meal_habit": {
        "key": "addon_adherence_prep_before_meal_habit",
        "id": "addon_adherence_prep_before_meal_habit",
        "title": "服薬忘れ対策（事前準備）",
        "group": "adherence",
        "targetSection": "P",
        "text": "忘れ防止策として、使用前に薬剤を準備する習慣づけを提案。"
      },
      "addon_sickday_hold_sglt2_metformin": {
        "key": "addon_sickday_hold_sglt2_metformin",
        "id": "addon_sickday_hold_sglt2_metformin",
        "title": "シックデイ時併用薬注意",
        "group": "sickday",
        "targetSection": "P",
        "text": "併用中のSGLT2阻害薬やメトホルミンは脱水時は中止が必要な場合があります。自己判断で中止せず、処方医へご相談ください。"
      }
